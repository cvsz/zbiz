{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cvsz/zbiz/schemas/company.schema.json",
  "title": "ZBiz Company Registration Package",
  "type": "object",
  "required": ["company", "capital", "founders", "shareholders", "directors", "objectives", "compliance"],
  "properties": {
    "company": {
      "type": "object",
      "required": ["legal_name_en", "business_type", "registered_office", "contact"],
      "properties": {
        "legal_name_th": {"type": "string", "minLength": 1},
        "legal_name_en": {"type": "string", "minLength": 1},
        "proposed_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "business_type": {"const": "private_limited_company"},
        "registered_office": {
          "type": "object",
          "required": ["address_line_1", "district", "province", "postal_code", "country"],
          "properties": {
            "address_line_1": {"type": "string", "minLength": 1},
            "address_line_2": {"type": "string"},
            "subdistrict": {"type": "string"},
            "district": {"type": "string", "minLength": 1},
            "province": {"type": "string", "minLength": 1},
            "postal_code": {"type": "string", "pattern": "^[0-9]{5}$"},
            "country": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "contact": {
          "type": "object",
          "required": ["email"],
          "properties": {
            "phone": {"type": "string"},
            "email": {"type": "string", "format": "email"},
            "website": {"type": "string", "format": "uri"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capital": {
      "type": "object",
      "required": ["registered_capital_thb", "par_value_thb", "total_shares", "paid_up_percentage"],
      "properties": {
        "registered_capital_thb": {"type": "integer", "minimum": 1},
        "par_value_thb": {"type": "integer", "minimum": 1},
        "total_shares": {"type": "integer", "minimum": 1},
        "paid_up_percentage": {"type": "number", "minimum": 25, "maximum": 100}
      },
      "additionalProperties": false
    },
    "founders": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "full_name_en", "nationality", "id_or_passport", "address"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "full_name_th": {"type": "string"},
          "full_name_en": {"type": "string", "minLength": 1},
          "nationality": {"type": "string", "minLength": 1},
          "id_or_passport": {"type": "string", "minLength": 1},
          "address": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "shareholders": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["founder_id", "share_count", "share_class"],
        "properties": {
          "founder_id": {"type": "string", "minLength": 1},
          "share_count": {"type": "integer", "minimum": 1},
          "share_class": {"enum": ["ordinary", "preferred"]}
        },
        "additionalProperties": false
      }
    },
    "directors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["founder_id", "signing_authority"],
        "properties": {
          "founder_id": {"type": "string", "minLength": 1},
          "signing_authority": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "compliance": {
      "type": "object",
      "required": ["beneficial_owners_reviewed", "identity_documents_verified", "registered_office_evidence_verified", "official_forms_current_version_confirmed"],
      "properties": {
        "beneficial_owners_reviewed": {"type": "boolean"},
        "identity_documents_verified": {"type": "boolean"},
        "registered_office_evidence_verified": {"type": "boolean"},
        "official_forms_current_version_confirmed": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
